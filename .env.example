# Copia in .env e cambia tutti i valori prima di usare dati veri.
# In produzione nessuno di questi valori di default va mantenuto.

# Postgres: proprietario dello schema (migrazioni) e ruolo dell'applicazione (soggetto a RLS)
POSTGRES_USER=redazione
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=redazione
APP_DB_USER=redazione_app
APP_DB_PASSWORD=change-me-app

# Chiave Fernet per cifrare i segreti a riposo (seed 2FA).
# Generala con: docker compose run --rm api python -m app.cli gen-key
SECRET_KEY=

# Storage S3 compatibile (SeaweedFS in sviluppo)
S3_ACCESS_KEY=redazione
S3_SECRET_KEY=change-me-storage
S3_BUCKET=redazione-sources

# Ambiente: development | production
ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173"]

# Trascrizione. In sviluppo (CPU) "small" è un buon compromesso; sul server con GPU: large-v3-turbo
STT_MODEL=small
STT_DEFAULT_LANGUAGE=it

# Riconoscimento degli interlocutori (pyannote). Richiede:
# 1. WITH_DIARIZATION=1 per installare torch + pyannote nell'immagine del worker
# 2. un token Hugging Face (https://huggingface.co/settings/tokens) con la licenza di
#    pyannote/speaker-diarization-community-1 accettata. I modelli girano in locale.
WITH_DIARIZATION=0
DIARIZATION_ENABLED=false
HF_TOKEN=

# Modello linguistico (API compatibile OpenAI). Lasciare vuoto per disattivare.
# Profili cloud: usati SOLO per le fonti normali (fornitore con zero data retention e DPA).
# Ogni funzione ha un livello: semplice (versione pulita, entità) → locale se c'è;
# medio (sintesi) → FAST; difficile (domande, verifica, scrittura) → STRONG.
# LLM_CLOUD_MODEL vale per entrambi se FAST/STRONG sono vuoti.
LLM_CLOUD_BASE_URL=https://openrouter.ai/api/v1
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL=
LLM_CLOUD_FAST_MODEL=anthropic/claude-haiku-5.5
LLM_CLOUD_STRONG_MODEL=anthropic/claude-sonnet-5.5
# Profilo locale (es. vLLM o Ollama sul server): l'unico ammesso per le fonti riservate e segrete
# e per qualsiasi richiesta che le includa (vince il livello più restrittivo).
# In sviluppo: il servizio "ollama" del compose (dopo `docker compose exec ollama ollama pull qwen2.5:3b`).
LLM_LOCAL_BASE_URL=http://ollama:11434/v1
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL=qwen2.5:3b

# Solo sviluppo: utente di prova creato da `python -m app.cli seed-dev`
DEV_USER_EMAIL=redattore@redazione.test
DEV_USER_PASSWORD=
